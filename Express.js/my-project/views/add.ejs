<!DOCTYPE html>
<html>
<head>
    <title>Add Phone</title>
</head>
<body>

<h1>Add Phone</h1>

<form action="/add" method="POST">

    <input
        type="text"
        name="name"
        placeholder="Phone Name"
        required
    >

    <br><br>

    <input
        type="text"
        name="description"
        placeholder="Description"
        required
    >

    <br><br>

    <input
        type="number"
        name="price"
        placeholder="Price"
        required
    >

    <br><br>

    <button>Add Phone</button>

</form>

</body>
</html>